{
    "extends": "@vue/tsconfig",
    "include": [
        "./src/*.ts",
        "./src/**/*.ts",
        "./src/**/*.vue"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["DOM", "ESNext"],
        "allowImportingTsExtensions": true,
        "moduleResolution": "bundler",
    },
    "vueCompilerOptions": {
        "target": 3.5
    }
}